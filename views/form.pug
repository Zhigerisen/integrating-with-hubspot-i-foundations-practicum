doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        header.topbar
            h1 Add inventory item
            a.btn.ghost(href="/") Back
        main
            .form-wrapper
                form(action="/inventory/new" method="POST")
                    label(for="name") Name
                    input#name(type="text" name="name" required placeholder="e.g. Wireless Mouse")
                    label(for="sku") SKU
                    input#sku(type="text" name="sku" placeholder="e.g. WM-204")
                    label(for="category") Category
                    input#category(type="text" name="category" placeholder="e.g. Accessories")
                    label(for="quantity") Quantity
                    input#quantity(type="number" name="quantity" min="0" placeholder="0")
                    label(for="unit_price") Unit price (USD)
                    input#unit_price(type="number" name="unit_price" min="0" step="0.01" placeholder="0.00")
                    input.btn.submit(type="submit" value="Create item")
