doctype html
html
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        header.topbar
            div
                h1 Inventory
                p.subtitle #{items.length} items, pulled live from HubSpot through the CRM API
            a.btn(href="/inventory/new") + Add item
        main
            table.items
                thead
                    tr
                        th Name
                        th SKU
                        th Category
                        th.num Qty
                        th.num Unit price
                tbody
                    each item in items
                        - var p = item.properties || {}
                        tr
                            td.name= p.name
                            td
                                if p.sku
                                    span.tag= p.sku
                            td= p.category
                            td.num= p.quantity
                            td.num= p.unit_price ? ('$' + p.unit_price) : ''
                    else
                        tr
                            td.empty(colspan=5) No items yet. Use Add item to create your first one.
